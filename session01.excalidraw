      "text": "then we have incidence vectors for x,y,z as following:\nx: 110100\ny: 110111\nz: 010000",
      "fontSize": 16,
      "fontFamily": 8,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "then we have incidence vectors for x,y,z as following:\nx: 110100\ny: 110111\nz: 010000",
      "autoResize": true,
      "lineHeight": 1.25
    },
