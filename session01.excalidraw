    {
      "id": "3z-7eX_o_urEWIrJnbiVV",
      "type": "text",
      "x": -6959.745712198684,
      "y": 3899.404057263652,
      "width": 387.199462890625,
      "height": 220,
      "angle": 0,
      "strokeColor": "#ffffff",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "dotted",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": "tlKtGbTjjYzuTSmBl1m5p",
      "index": "bcf",
      "roundness": null,
      "seed": 1437444699,
      "version": 386,
      "versionNonce": 306980966,
      "isDeleted": true,
      "boundElements": [],
      "updated": 1781983270260,
      "link": null,
      "locked": false,
      "text": "Disadvantages:\nconsider N = 1e6 documentes\neach document has 1e3 words\neach word has 6 letters (bytes)\n\n=> 6e9 bytes = 6 GB of data\n\nif M = 5e5 distinct terms among these\nthen:\n    to build to matrix we need:\n    M * N bits = 5e11 bit = 62.5 GB [DAMN!!]",
      "fontSize": 16,
      "fontFamily": 8,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Disadvantages:\nconsider N = 1e6 documentes\neach document has 1e3 words\neach word has 6 letters (bytes)\n\n=> 6e9 bytes = 6 GB of data\n\nif M = 5e5 distinct terms among these\nthen:\n    to build to matrix we need:\n    M * N bits = 5e11 bit = 62.5 GB [DAMN!!]",
      "autoResize": true,
      "lineHeight": 1.25
    },
